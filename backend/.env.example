PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27018/growme
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Email Service (Gmail SMTP)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=

# Base64 value from: openssl rand -base64 32
GROWME_CONNECTION_KEY=
# Optional GrowMe media account for CRM assets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional public origin for hosted agency pages and bio links.
HOSTED_WEBSITE_BASE_URL=

# Comma-separated extra browser origins; set ALLOW_VERCEL_PREVIEWS=false to stop trusting every *.vercel.app site
CORS_ORIGINS=
ALLOW_VERCEL_PREVIEWS=true

# Webhook handshake tokens (min 16 chars, e.g. openssl rand -hex 24). There is no default: unset = verification refused.
META_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret used to verify X-Hub-Signature-256 on webhook payloads
META_APP_SECRET=
META_GRAPH_VERSION=
META_LEAD_PAGE_TOKENS={}
