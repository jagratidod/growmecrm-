# API Base URL (e.g., https://your-backend-api.com/api or /api)
VITE_API_BASE_URL=/api

# Toggle mock data mode ('true' for mock auth & leads, 'false' for live backend API)

# Optional API for the marketing contact, quote and newsletter forms.
VITE_MARKETING_API_BASE_URL=

# Optional public contact details and API base (the service must handle POST /contact).
VITE_MARKETING_CONTACT_EMAIL=
VITE_MARKETING_API_BASE_URL=
